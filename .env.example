# Copy this file to .env and adjust before running docker compose up.
# .env is gitignored; these are local-development defaults only.

# --- Postgres --------------------------------------------------------------
# POSTGRES_USER is the *bootstrap* role (creates the DB, runs initdb) — it is
# a superuser by construction of the official postgres image and is NEVER used
# by the application. See deploy/postgres-init/01-app-role.sh for why that
# distinction matters: a superuser silently bypasses every row-level-security
# policy this project's tenant isolation depends on.
POSTGRES_USER=postgres_bootstrap
POSTGRES_PASSWORD=change-me-bootstrap-password
POSTGRES_DB=gateway

# The gateway connects as this restricted role instead (created by the init
# script above). Change this password for anything beyond local development.
GATEWAY_APP_PASSWORD=change-me-app-password

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis-password

# --- Gateway -----------------------------------------------------------------
# Shared secret for POST /v1/admin/tenants (tenant provisioning). Generate a
# real one with: openssl rand -hex 32
BOOTSTRAP_KEY=change-me-bootstrap-key
JWT_ISSUER=https://gateway.local
JWT_AUDIENCE=identity-gateway

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# Optional JSON proxy rollout flags, reloaded on SIGHUP (see README).
# FEATURE_FLAGS_FILE=/path/to/feature-flags.json
